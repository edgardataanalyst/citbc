<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#ffffff">
  <meta name="description" content="Learn about the history, vision, mission, and leadership of Christ Is TRUTH Baptist Church International.">

  <title>About Us | CITBC International</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      scroll-padding-top: 100px;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #ffffff;
      color: #17243a;
      line-height: 1.7;
      overflow-x: hidden;
    }

    /* HEADER */
    header {
      min-height: 90px;
      padding: 12px 5%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      background: #ffffff;
      box-shadow: 0 2px 12px rgba(0,0,0,.08);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      min-width: 0;
    }

    .church-logo {
      width: 62px;
      height: 62px;
      object-fit: contain;
      flex-shrink: 0;
    }

    .logo-text strong {
      display: block;
      color: #17243a;
      font-size: 21px;
      line-height: 1.3;
    }

    .logo-text span {
      display: block;
      color: #9a7626;
      font-size: 9px;
      letter-spacing: .8px;
      line-height: 1.6;
    }

    nav {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    nav a {
      text-decoration: none;
      color: #17243a;
      font-size: 14px;
      font-weight: 600;
    }

    nav a:hover,
    nav a.active {
      color: #a5802d;
    }

    .menu-toggle {
      display: none;
      background: #ffffff;
      color: #17243a;
      border: 1px solid #d9dfeb;
      border-radius: 5px;
      width: 42px;
      height: 42px;
      font-size: 23px;
      cursor: pointer;
    }

    /* PAGE INTRO */
    .page-hero {
      background: linear-gradient(135deg, #0b1930, #203c60);
      color: #ffffff;
      text-align: center;
      padding: 75px 20px;
    }

    .eyebrow {
      color: #e5c779;
      font-size: 12px;
      font-weight: bold;
      letter-spacing: 3px;
      margin-bottom: 12px;
    }

    .page-hero h1 {
      font-size: clamp(34px, 5vw, 54px);
      line-height: 1.2;
      margin-bottom: 15px;
    }

    .page-hero h1 span {
      color: #e5c779;
    }

    .page-hero p:last-child {
      max-width: 680px;
      margin: auto;
      color: #e0e6ef;
      font-size: 16px;
    }

    /* GENERAL SECTIONS */
    .section {
      padding: 75px 6%;
    }

    .section-heading {
      text-align: center;
      margin-bottom: 38px;
    }

    .section-heading .eyebrow {
      color: #a5802d;
    }

    .section-heading h2 {
      color: #17243a;
      font-size: clamp(28px, 4vw, 38px);
      line-height: 1.3;
      margin-bottom: 12px;
    }

    .section-heading p {
      max-width: 700px;
      margin: auto;
      color: #657083;
      font-size: 15px;
    }

    /* SECTION 1: HISTORY */
    .history-section {
      background: #ffffff;
    }

    .history-content {
      max-width: 1050px;
      margin: auto;
      display: grid;
      grid-template-columns: 1fr 1.1fr;
      align-items: center;
      gap: 45px;
    }

    .history-image {
      width: 100%;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      border-radius: 10px;
      background: #edf0f5;
    }

    .history-text h3 {
      color: #17243a;
      font-size: 26px;
      margin-bottom: 15px;
    }

    .history-text p {
      color: #596273;
      font-size: 15px;
      line-height: 1.9;
      margin-bottom: 14px;
    }

    /* SECTION 2: VISION & MISSION */
    .vision-section {
      background: #f7f8fb;
    }

    .vision-grid {
      max-width: 1050px;
      margin: auto;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 25px;
    }

    .vision-card {
      background: #ffffff;
      padding: 35px;
      border-radius: 10px;
      border: 1px solid #e6e9ef;
      border-top: 4px solid #d8b765;
      box-shadow: 0 8px 24px rgba(17,35,61,.05);
    }

    .vision-card .symbol {
      width: 50px;
      height: 50px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: #f8f0d9;
      color: #8d6a21;
      font-size: 24px;
      margin-bottom: 20px;
    }

    .vision-card h3 {
      font-size: 23px;
      color: #17243a;
      margin-bottom: 14px;
    }

    .vision-card p {
      color: #596273;
      font-size: 15px;
      line-height: 1.9;
    }

    /* SECTION 3: BOARD OF TRUSTEES */
    .trustees-section {
      background: #ffffff;
    }

    .trustees-grid {
      max-width: 1100px;
      margin: auto;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 28px;
    }

    .trustee-card {
      background: #ffffff;
      border: 1px solid #e6e9ef;
      border-radius: 10px;
      overflow: hidden;
      text-align: center;
      box-shadow: 0 6px 22px rgba(17,35,61,.06);
      transition: transform .25s, box-shadow .25s;
    }

    .trustee-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 28px rgba(17,35,61,.12);
    }

    .trustee-photo {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 4.2;
      object-fit: cover;
      object-position: center top;
      background: #edf0f5;
    }

    .trustee-info {
      padding: 22px 12px 25px;
    }

    .trustee-info h3 {
      color: #17243a;
      font-size: 17px;
      line-height: 1.5;
      margin-bottom: 5px;
    }

    .trustee-info p {
      color: #9a7626;
      font-size: 13px;
      font-weight: 600;
    }

    /* FOOTER */
    footer {
      padding: 30px 18px;
      background: #ffffff;
      border-top: 1px solid #e5e7eb;
      text-align: center;
      color: #26334a;
      font-size: 13px;
    }

    footer p {
      margin-bottom: 5px;
    }

    footer .copyright {
      color: #6b7280;
      font-size: 12px;
    }

    /* TABLET */
    @media (max-width: 850px) {
      header {
        padding-left: 4%;
        padding-right: 4%;
      }

      nav {
        gap: 13px;
      }

      nav a {
        font-size: 12px;
      }

      .history-content {
        gap: 25px;
      }

      .trustees-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    /* MOBILE */
    @media (max-width: 650px) {
      header {
        min-height: 76px;
        padding: 10px 15px;
        gap: 8px;
      }

      .brand {
        gap: 8px;
      }

      .church-logo {
        width: 46px;
        height: 46px;
      }

      .logo-text strong {
        font-size: 17px;
      }

      .logo-text span {
        font-size: 7px;
        letter-spacing: .4px;
      }

      .menu-toggle {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      nav {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        padding: 10px 20px 20px;
        background: #ffffff;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        box-shadow: 0 8px 12px rgba(0,0,0,.08);
      }

      nav.open {
        display: flex;
      }

      nav a {
        display: block;
        padding: 14px 8px;
        border-bottom: 1px solid #eeeeee;
        font-size: 14px;
      }

      .page-hero {
        padding: 55px 20px;
      }

      .page-hero p:last-child {
        font-size: 14px;
      }

      .section {
        padding: 55px 20px;
      }

      .section-heading {
        margin-bottom: 28px;
      }

      .history-content {
        grid-template-columns: 1fr;
        gap: 24px;
      }

      .history-text h3 {
        font-size: 23px;
      }

      .vision-grid {
        grid-template-columns: 1fr;
        gap: 18px;
      }

      .vision-card {
        padding: 26px 22px;
      }

      .trustees-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
      }

      .trustee-info {
        padding: 15px 8px 18px;
      }

      .trustee-info h3 {
        font-size: 14px;
      }

      .trustee-info p {
        font-size: 12px;
      }
    }

    @media (max-width: 360px) {
      .trustees-grid {
        grid-template-columns: 1fr;
      }

      .trustee-photo {
        aspect-ratio: 4 / 3.5;
      }
    }
  </style>
</head>

<body>

  <!-- HEADER -->
  <header>
    <a href="index.html" class="brand" aria-label="CITBC Home">
      <img
        src="Images/citbc_logo.png"
        alt="CITBC Logo"
        class="church-logo">

      <div class="logo-text">
        <strong>Christ is TRUTH</strong>
        <span>BAPTIST CHURCH</span>
        <span>INTERNATIONAL</span>
      </div>
    </a>

    <button
      class="menu-toggle"
      id="menuToggle"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mainNav"
      type="button">
      ☰
    </button>

    <nav id="mainNav">
      <a href="index.html">Home</a>
      <a href="about.html" class="active">About Us</a>
      <a href="index.html#ministries">Ministries</a>
      <a href="index.html#prayer">Prayer Request</a>
      <a href="index.html#contact">Contact</a>
    </nav>
  </header>

  <!-- PAGE INTRO -->
  <section class="page-hero">
    <p class="eyebrow">GET TO KNOW US</p>

    <h1>About <span>Our Church</span></h1>

    <p>
      Learn about our history, our vision and mission,
      and the people entrusted with serving our church.
    </p>
  </section>

  <!-- SECTION 1: HISTORY -->
  <section class="section history-section" id="history">

    <div class="section-heading">
      <p class="eyebrow">OUR BEGINNINGS</p>
      <h2>Our <span>History</span></h2>
      <p>
        Discover the story and journey of
        Christ Is TRUTH Baptist Church International.
      </p>
    </div>

    <div class="history-content">

      <!-- Replace with your actual church history image -->
      <img
        src="Images/church_history.jpg"
        alt="Christ Is TRUTH Baptist Church history"
        class="history-image">

      <div class="history-text">
        <h3>A Journey of Faith</h3>

        <p>
          Christ Is TRUTH Baptist Church International
          is committed to honoring God, proclaiming the
          truth of His Word, and sharing the message of
          Jesus Christ.
        </p>

        <p>
          Through worship, fellowship, and Christian
          service, our desire is to encourage believers
          to grow in faith and to make Christ known.
        </p>

        <p>
          Our church history, founding date, and
          important milestones will be presented here
          using the official information of our church.
        </p>
      </div>

    </div>
  </section>

  <!-- SECTION 2: VISION AND MISSION -->
  <section class="section vision-section" id="vision-mission">

    <div class="section-heading">
      <p class="eyebrow">OUR PURPOSE</p>
      <h2>Vision &amp; <span>Mission</span></h2>
      <p>
        Our guiding purpose as a church community.
      </p>
    </div>

    <div class="vision-grid">

      <article class="vision-card">
        <div class="symbol" aria-hidden="true">◎</div>

        <h3>Our Vision</h3>

        <p>
          To be a Christ-centered church that upholds
          the truth of God's Word and encourages people
          to know, love, and follow Jesus Christ.
        </p>
      </article>

      <article class="vision-card">
        <div class="symbol" aria-hidden="true">✝</div>

        <h3>Our Mission</h3>

        <p>
          To proclaim the Gospel of Jesus Christ,
          teach the truth of Scripture, nurture
          believers in their faith, and serve others
          through Christian love and fellowship.
        </p>
      </article>

    </div>
  </section>

  <!-- SECTION 3: BOARD OF TRUSTEES -->
  <section class="section trustees-section" id="trustees">

    <div class="section-heading">
      <p class="eyebrow">OUR LEADERSHIP</p>
      <h2>Board of <span>Trustees</span></h2>
      <p>
        Meet the individuals entrusted with leadership
        and service in our church.
      </p>
    </div>

    <div class="trustees-grid">

      <!-- TRUSTEE 1 -->
      <article class="trustee-card">
        <img
          src="Images/trustee1.jpg"
          alt="Board of Trustees member"
          class="trustee-photo"
          loading="lazy">

        <div class="trustee-info">
          <h3>Trustee Name 1</h3>
          <p>Chairperson</p>
        </div>
      </article>

      <!-- TRUSTEE 2 -->
      <article class="trustee-card">
        <img
          src="Images/trustee2.jpg"
          alt="Board of Trustees member"
          class="trustee-photo"
          loading="lazy">

        <div class="trustee-info">
          <h3>Trustee Name 2</h3>
          <p>Vice Chairperson</p>
        </div>
      </article>

      <!-- TRUSTEE 3 -->
      <article class="trustee-card">
        <img
          src="Images/trustee3.jpg"
          alt="Board of Trustees member"
          class="trustee-photo"
          loading="lazy">

        <div class="trustee-info">
          <h3>Trustee Name 3</h3>
          <p>Secretary</p>
        </div>
      </article>

      <!-- TRUSTEE 4 -->
      <article class="trustee-card">
        <img
          src="Images/trustee4.jpg"
          alt="Board of Trustees member"
          class="trustee-photo"
          loading="lazy">

        <div class="trustee-info">
          <h3>Trustee Name 4</h3>
          <p>Treasurer</p>
        </div>
      </article>

      <!-- TRUSTEE 5 -->
      <article class="trustee-card">
        <img
          src="Images/trustee5.jpg"
          alt="Board of Trustees member"
          class="trustee-photo"
          loading="lazy">

        <div class="trustee-info">
          <h3>Trustee Name 5</h3>
          <p>Board Member</p>
        </div>
      </article>

      <!-- TRUSTEE 6 -->
      <article class="trustee-card">
        <img
          src="Images/trustee6.jpg"
          alt="Board of Trustees member"
          class="trustee-photo"
          loading="lazy">

        <div class="trustee-info">
          <h3>Trustee Name 6</h3>
          <p>Board Member</p>
        </div>
      </article>

    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <p>
      <strong>Christ Is TRUTH Baptist Church International</strong>
    </p>

    <p>"Jesus Christ, the Rock Upon This House"</p>

    <p class="copyright">
      &copy; <span id="year">2026</span> CITBC.
      All rights reserved.
    </p>
  </footer>

  <script>
    const menuToggle = document.getElementById("menuToggle");
    const mainNav = document.getElementById("mainNav");

    menuToggle.addEventListener("click", function () {
      const isOpen = mainNav.classList.toggle("open");

      menuToggle.setAttribute("aria-expanded", String(isOpen));

      menuToggle.setAttribute(
        "aria-label",
        isOpen ? "Close navigation menu" : "Open navigation menu"
      );

      menuToggle.textContent = isOpen ? "✕" : "☰";
    });

    mainNav.querySelectorAll("a").forEach(function (link) {
      link.addEventListener("click", function () {
        mainNav.classList.remove("open");
        menuToggle.setAttribute("aria-expanded", "false");
        menuToggle.setAttribute("aria-label", "Open navigation menu");
        menuToggle.textContent = "☰";
      });
    });

    document.getElementById("year").textContent =
      new Date().getFullYear();
  </script>

</body>
</html>
